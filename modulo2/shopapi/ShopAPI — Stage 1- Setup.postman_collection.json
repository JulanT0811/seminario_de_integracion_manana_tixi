                      "if (j.access) {",
                      "  pm.collectionVariables.set('access',  j.access);",
                      "  pm.collectionVariables.set('refresh', j.refresh);",
                      "  pm.environment.set('access',  j.access);",
                      "  pm.environment.set('refresh', j.refresh);",
                      "  console.log('Tokens guardados desde register');",
                      "} else {",
