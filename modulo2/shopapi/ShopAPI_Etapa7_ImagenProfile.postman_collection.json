{
	"info": {
		"_postman_id": "shopapi-etapa7-imagen",
		"name": "ShopAPI — Etapa 7: Avatar y Imagen Producto",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"description": "Colección para probar avatares de usuario e imágenes de producto.\n\n**Flujo:**\n1. Ejecuta **Register** o **Login** (guarda automáticamente el token)\n2. Usa cualquier endpoint autenticado (Header Authorization se rellena automáticamente)"
	},
	"item": [
		{
			"name": "🔐 Auth",
			"item": [
				{
					"name": "1️⃣ Register (nuevo usuario)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('✅ Status 201 Created', () => pm.response.to.have.status(201));",
									"const j = pm.response.json();",
									"pm.collectionVariables.set('access',  j.access);",
									"pm.collectionVariables.set('refresh', j.refresh);",
									"pm.collectionVariables.set('user_id', j.user_id);",
									"console.log('✅ Token guardado. Usuario ID:', j.user_id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"ana\",\n  \"email\": \"ana@test.com\",\n  \"password\": \"Test1234!\",\n  \"password2\": \"Test1234!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register",
								""
							]
						}
					},
					"response": []
				},
				{
					"name": "2️⃣ Login (usuario existente)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('✅ Status 200 OK', () => pm.response.to.have.status(200));",
									"const j = pm.response.json();",
									"pm.collectionVariables.set('access',  j.access);",
									"pm.collectionVariables.set('refresh', j.refresh);",
									"pm.collectionVariables.set('user_id', j.user_id);",
									"console.log('✅ Token actualizado. Usuario:', j.username);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"ana\",\n  \"password\": \"Test1234!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login",
								""
							]
						}
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('✅ Status 200', () => pm.response.to.have.status(200));",
									"const j = pm.response.json();",
									"pm.collectionVariables.set('access',  j.access);",
									"console.log('✅ Token refrescado');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh\": \"{{refresh}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/token/refresh/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"token",
								"refresh",
								""
							]
						}
					},
					"response": []
				},
				{
					"name": "Logout",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('✅ Status 200', () => pm.response.to.have.status(200));",
									"console.log('✅ Sesión cerrada');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh\": \"{{refresh}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/logout/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"logout",
								""
							]
						}
					},
					"response": []
				}
			]
		},
